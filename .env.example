# ==========================================
# ParkWise Smart Parking System - Environment Configuration
# ==========================================

# Main Relational Database (MySQL 8.0)
DATABASE_URL="mysql://parkwise:replace_with_local_password@localhost:3306/parkwise_db"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="parkwise"
MYSQL_PASSWORD="replace_with_local_password"
MYSQL_DATABASE="parkwise_db"

# Secondary Document Database (MongoDB)
# Connects to local mongod or starts embedded mongodb-memory-server automatically
MONGODB_URI="mongodb://127.0.0.1:27017/parkwise"
MONGODB_DB_NAME="parkwise"

# Authentication & Session Security
SESSION_SECRET=""
NODE_ENV="development"

# Map & Routing Service Configuration
NEXT_PUBLIC_MAP_DEFAULT_LAT="12.9352"
NEXT_PUBLIC_MAP_DEFAULT_LNG="77.5360"
GEOCODING_API_URL="https://nominatim.openstreetmap.org"
ROUTING_API_URL="https://router.project-osrm.org"
